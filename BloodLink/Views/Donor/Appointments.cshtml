@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BloodLink | Book a Donation</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@400;500;600;700;800&family=Manrope:wght@@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/donorRequests.css">
  <link rel="stylesheet" href="/css/donorAppointments.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/" aria-label="BloodLink home">
    <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 32 32"><path d="M16 3.5C13 8.1 7.1 14.1 7.1 19.5a8.9 8.9 0 0 0 17.8 0C24.9 14.1 19 8.1 16 3.5Z" fill="currentColor"/><path d="M11.7 20.1c.3 2.1 1.7 3.4 3.8 3.7" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="1.8"/></svg></span>
    <span>Blood<span class="brand-accent">Link</span><small>Every second can save a life</small></span>
  </a>

<nav class="main-nav" aria-label="Primary">
  <a href="/" class="main-nav-link">Home</a>
  <a href="/Donor/Search" class="main-nav-link">Find Donors</a>
  <a href="/Recipient/Requests" class="main-nav-link">My Requests</a>
  <a href="/Donor/Appointments" class="main-nav-link active" aria-current="page">Book Donation</a>
</nav>

  <nav class="top-actions" aria-label="Account">
    <div class="profile-menu" id="profileMenu">
      <button class="profile-chip" id="profileMenuToggle" type="button" aria-expanded="false" aria-controls="profileDropdown">
        <span class="profile-avatar">G</span>
        <span class="profile-label"><strong>Guest</strong><small>Welcome to BloodLink</small></span>
        <span class="chevron" aria-hidden="true">⌄</span>
      </button>
      <div class="profile-dropdown" id="profileDropdown" hidden>
        <div class="dropdown-user">
          <span class="profile-avatar">G</span>
          <span><strong>Guest account</strong><small>Sign in to manage your profile</small></span>
        </div>
        <div class="dropdown-divider"></div>
        <a href="/Account/Profile" class="dropdown-item"><span class="dropdown-icon">♙</span><span><strong>My profile</strong><small>View your personal details</small></span><span class="dropdown-arrow">›</span></a>
        <a href="/" class="dropdown-item"><span class="dropdown-icon">⌕</span><span><strong>Sign out</strong><small>Search nearby blood donors</small></span><span class="dropdown-arrow">›</span></a>
      </div>
    </div>
  </nav>
</header>

<main class="page">
  <section class="welcome">
    <div>
      <span class="eyebrow"><i></i> DONATE BLOOD</span>
      <h1>Book a donation appointment</h1>
      <p>Pick a hospital or donation center, choose a convenient date, and answer a quick eligibility check. The center confirms your exact time.</p>
    </div>
  </section>

  <section class="summary-grid">
    <article class="summary-card"><span class="summary-icon red">▤</span><div><small>My appointments</small><strong id="sumTotal">0</strong><em>All booking requests</em></div></article>
    <article class="summary-card"><span class="summary-icon amber">◷</span><div><small>Awaiting approval</small><strong id="sumPending">0</strong><em>Sent to the center</em></div></article>
    <article class="summary-card"><span class="summary-icon green">✓</span><div><small>Confirmed</small><strong id="sumApproved">0</strong><em>Date and time set</em></div></article>
    <article class="summary-card"><span class="summary-icon blue">♥</span><div><small>Completed</small><strong id="sumDone">0</strong><em>Donations made</em></div></article>
  </section>

  <div id="confirmedBanner"></div>

  <section class="content-grid">
    <div class="ap-main">
      <section class="requests-panel ap-form-panel" id="bookingPanel">
        <div class="panel-heading">
          <div><span class="eyebrow">NEW APPOINTMENT</span><h2>Book your donation</h2><p>Three quick steps. It takes about two minutes.</p></div>
        </div>
        <form id="bookingForm" class="ap-form" novalidate>
          <div class="ap-step">
            <div class="ap-step-head"><span>1</span><div><b>Choose where to donate</b><small>Only verified hospitals and centers are listed.</small></div></div>
            <div class="ap-facilities" id="facilityList" role="radiogroup" aria-label="Hospital or center"></div>
          </div>

          <div class="ap-step">
            <div class="ap-step-head"><span>2</span><div><b>Your details and preferred time</b><small>The center will confirm the exact time, or suggest another one.</small></div></div>
            <div class="ap-grid">
              <label>Full name<input name="name" required maxlength="60" autocomplete="name" placeholder="e.g. Lina Khalil"></label>
              <label>Phone number<input name="phone" required maxlength="20" autocomplete="tel" inputmode="tel" placeholder="07X XXX XXXX"></label>
              <label>Email <small>optional</small><input name="email" type="email" maxlength="80" autocomplete="email" placeholder="you@@example.com"></label>
              <label>Blood type<select name="type" required><option value="">Select blood type</option><option>O+</option><option>O-</option><option>A+</option><option>A-</option><option>B+</option><option>B-</option><option>AB+</option><option>AB-</option><option>I don't know</option></select></label>
              <label>Preferred date<input name="date" id="apDate" type="date" required></label>
              <label>Preferred time<select name="time" id="apTime" required></select></label>
              <label class="ap-wide">Notes for the center <small>optional</small><textarea name="notes" rows="2" maxlength="200" placeholder="e.g. I can only come after work, or I need a wheelchair-accessible entrance"></textarea></label>
            </div>
            <p class="ap-hint" id="dateHint"></p>
          </div>

          <div class="ap-step">
            <div class="ap-step-head"><span>3</span><div><b>Quick eligibility check</b><small>Answer honestly. This protects you and the patient.</small></div><span class="ap-elig" id="eligChip" data-state="idle">Not checked yet</span></div>
            <div class="ap-grid">
              <label>Age <small>years</small><input name="age" type="number" min="1" max="120" inputmode="numeric" required placeholder="e.g. 28"></label>
              <label>Weight <small>kg</small><input name="weight" type="number" min="20" max="250" inputmode="decimal" required placeholder="e.g. 70"></label>
              <label class="ap-wide">Last donation date <small>leave empty if you've never donated</small><input name="lastDonation" id="apLast" type="date"></label>
            </div>
            <div class="ap-questions">
              <fieldset class="ap-q"><legend>Do you feel healthy today, with no fever, cold or infection?</legend>
                <div class="ap-yn"><label><input type="radio" name="well" value="yes" required><span>Yes</span></label><label><input type="radio" name="well" value="no"><span>No</span></label></div></fieldset>
              <fieldset class="ap-q"><legend>Are you taking any medication? <small>antibiotics, blood thinners, acne medicine…</small></legend>
                <div class="ap-yn"><label><input type="radio" name="meds" value="no" required><span>No</span></label><label><input type="radio" name="meds" value="yes"><span>Yes</span></label></div>
                <input class="ap-follow" name="medsDetail" maxlength="80" placeholder="Which medication?" hidden></fieldset>
              <fieldset class="ap-q"><legend>Have you travelled outside Jordan in the last 3 months?</legend>
                <div class="ap-yn"><label><input type="radio" name="travel" value="no" required><span>No</span></label><label><input type="radio" name="travel" value="yes"><span>Yes</span></label></div>
                <input class="ap-follow" name="travelDetail" maxlength="80" placeholder="Which countries, and when?" hidden></fieldset>
              <fieldset class="ap-q"><legend>In the last 6 months, did you get a tattoo, piercing, surgery or dental procedure?</legend>
                <div class="ap-yn"><label><input type="radio" name="procedure" value="no" required><span>No</span></label><label><input type="radio" name="procedure" value="yes"><span>Yes</span></label></div></fieldset>
            </div>
            <div class="ap-result" id="eligResult" role="status" aria-live="polite"></div>
          </div>

          <label class="ap-consent"><input type="checkbox" name="consent" required> I confirm my answers are true, and I understand the center makes the final decision on my eligibility.</label>
          <p class="ap-error" id="formError" role="alert" hidden></p>
          <div class="ap-actions"><small>Demo only: no real medical advice or screening.</small><button class="primary-btn ap-submit" id="submitBtn" type="submit">Send booking request →</button></div>
        </form>
      </section>

      <section class="requests-panel ap-list-panel" id="myAppointments">
        <div class="panel-heading">
          <div><span class="eyebrow">YOUR BOOKINGS</span><h2>My appointments <span class="count-badge" id="listCount">0</span></h2><p>Track each request and see the time the center confirms.</p></div>
        </div>
        <div class="ap-list" id="apList"></div>
        <div class="empty-state hidden" id="apEmpty"><span>▤</span><b>No appointments yet</b><p>Book your first donation above. The center's reply will appear here.</p></div>
      </section>
    </div>

    <aside class="side-column">
      <section class="help-card">
        <div class="help-icon">♥</div><h3>Why book ahead?</h3>
        <p>Booked donors skip the queue and help centers plan their stock. One donation can help up to three people.</p>
      </section>
      <section class="timeline-card">
        <span class="eyebrow">HOW IT WORKS</span><h3>Appointment journey</h3>
        <div class="journey">
          <div class="journey-step done"><span>✓</span><div><b>Send your request</b><small>Choose a place, a date and answer the eligibility check.</small></div></div>
          <div class="journey-step current"><span>2</span><div><b>Center reviews it</b><small>The hospital checks your answers and availability.</small></div></div>
          <div class="journey-step"><span>3</span><div><b>You get a confirmed time</b><small>The date and time appear here as soon as it is approved.</small></div></div>
          <div class="journey-step"><span>4</span><div><b>Donate</b><small>Bring an ID, eat well and drink water beforehand.</small></div></div>
        </div>
      </section>
      <section class="help-card ap-tips">
        <h3>Before you donate</h3>
        <ul><li>Eat a meal and drink water</li><li>Sleep well the night before</li><li>Bring a valid ID</li><li>Avoid heavy exercise afterwards</li></ul>
      </section>
    </aside>
  </section>
</main>

<div class="toast" id="toast" role="status"></div>
<script src="/js/donorAppointments.js"></script>
<script>
(() => {
  const menu = document.getElementById('profileMenu');
  const toggle = document.getElementById('profileMenuToggle');
  const dropdown = document.getElementById('profileDropdown');
  if (!menu || !toggle || !dropdown) return;
  const setOpen = (open) => {
    dropdown.hidden = !open;
    menu.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
  };
  toggle.addEventListener('click', (event) => {
    event.preventDefault();
    event.stopPropagation();
    setOpen(dropdown.hidden);
  });
  dropdown.addEventListener('click', (event) => event.stopPropagation());
  document.addEventListener('click', (event) => {
    if (!menu.contains(event.target)) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') { setOpen(false); toggle.focus(); }
  });
})();
</script>
</body>
</html>